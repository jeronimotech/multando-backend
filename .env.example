# =============================================================================
# Multando Backend — Environment Variables
# =============================================================================
# Copy to `.env` and fill in. Only the CORE section is required to boot;
# every integration below is opt-in and disabled by default.
#
#   cp .env.example .env
#
# Self-hosters: the minimum to run is DATABASE_URL, REDIS_URL, SECRET_KEY,
# and an S3/MinIO bucket for evidence. Everything else can stay default.
# =============================================================================

# -----------------------------------------------------------------------------
# Core (required)
# -----------------------------------------------------------------------------
APP_NAME=Multando API
APP_ENV=production                 # development | production
DEBUG=false

DATABASE_URL=postgresql+asyncpg://multando:changeme@postgres:5432/multando
REDIS_URL=redis://redis:6379/0

# Generate a strong value:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Comma-separated list of allowed CORS origins (JSON array also accepted)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

RATE_LIMIT_PER_MINUTE=60

# PostgreSQL password (consumed by docker-compose for the postgres container)
POSTGRES_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Evidence storage — AWS S3 or MinIO
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=                   # e.g. https://minio.example.com (leave empty for real AWS S3)
S3_BUCKET=multando-evidence
STORAGE_BASE_URL=https://storage.multando.com

# -----------------------------------------------------------------------------
# Celery (background tasks: scrapers, submissions, blockchain sync)
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# Anthropic (AI chatbot + tweet infraction extraction) — console.anthropic.com
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Service-to-service key the chatbot uses to call the backend
CHATBOT_API_KEY=

# -----------------------------------------------------------------------------
# OAuth — Social login (Google). GitHub is deprecated/optional.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com   # Web client (code exchange + default audience)
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CLIENT_ID_ANDROID=          # Android client ID (ID-token audience)
GOOGLE_CLIENT_ID_IOS=              # iOS client ID (ID-token audience)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# OAuth 2.0 Provider — Multando as an authorization server ("Connect Multando")
# Lets third-party apps log users in without a second account.
# -----------------------------------------------------------------------------
OAUTH_CODE_EXPIRE_MINUTES=10
OAUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# WhatsApp Cloud API — conversational reporting bot (Meta Business account)
# Set WHATSAPP_ENABLED=true and configure the webhook in Meta to activate.
# -----------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=                    # Permanent access token from Meta
WHATSAPP_PHONE_NUMBER_ID=          # Phone number ID from the WhatsApp app
WHATSAPP_VERIFY_TOKEN=multando-verify   # Arbitrary string; also paste into Meta's webhook config
WHATSAPP_API_VERSION=v18.0
WHATSAPP_APP_SECRET=               # App secret — used to verify webhook signatures
WHATSAPP_CONVERSATION_TTL_SECONDS=1800   # Idle timeout before a conversation resets (30 min)
WHATSAPP_MAX_REPORTS_PER_PHONE_PER_DAY=10

# -----------------------------------------------------------------------------
# Apify — Twitter/X hashtag scraping (apify.com)
# Configured hashtags are scraped on a schedule; each tweet is run through
# Claude to extract plate/infraction/location and auto-create pending reports.
# Manage hashtags in the authority panel (/authority/twitter).
# -----------------------------------------------------------------------------
APIFY_ENABLED=false
APIFY_API_TOKEN=                   # apify_api_...
APIFY_TWITTER_ACTOR_ID=apidojo/tweet-scraper
APIFY_SCRAPE_INTERVAL_HOURS=24     # How often the beat task runs (24 = once a day)
APIFY_MAX_TWEETS_PER_RUN=100
APIFY_MIN_CONFIDENCE_THRESHOLD=0.5 # Below this, tweets go to admin triage instead of auto-create
APIFY_AUTO_CREATE_REPORTS=true     # false = queue everything for manual review

# -----------------------------------------------------------------------------
# RECORD (Ministerio de Transporte) — national infraction form auto-submission
# Uses Playwright + 2captcha. Set RECORD_ENABLED=true to dispatch submissions.
# -----------------------------------------------------------------------------
RECORD_ENABLED=false
TWOCAPTCHA_API_KEY=

# -----------------------------------------------------------------------------
# Bogota SDM (Secretaría Distrital de Movilidad) — Google Form submission
# Verified Bogota reports get a pre-filled SDM form URL + Drive-hosted evidence.
# -----------------------------------------------------------------------------
SDM_FORM_ENABLED=false
SDM_FORM_ID=1FAIpQLSeCG84Le6cCxegrj7ns_oA36t1GJe4sHKdblOYum_vuTOXYFQ
SDM_GOOGLE_SERVICE_ACCOUNT_JSON=   # Path to the service-account JSON file, or the JSON string itself
SDM_GOOGLE_DRIVE_FOLDER_ID=        # Drive folder (shared with the service account) for evidence uploads

# -----------------------------------------------------------------------------
# Solana blockchain — MULTA token rewards
# -----------------------------------------------------------------------------
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet              # devnet | testnet | mainnet-beta
SOLANA_PROGRAM_ID=
SOLANA_MINT_ADDRESS=
SOLANA_REWARD_AUTHORITY_KEY=       # Base58-encoded private key of the reward authority

# Hot wallet (for processing withdrawals)
HOT_WALLET_KEYPAIR_PATH=
HOT_WALLET_MIN_BALANCE=1000.0

# -----------------------------------------------------------------------------
# Custodial wallet encryption
# -----------------------------------------------------------------------------
WALLET_ENCRYPTION_PROVIDER=local   # local | kms
WALLET_MASTER_KEY=                 # Fernet key for local mode; leave empty to auto-generate (dev only)
AWS_KMS_KEY_ID=                    # KMS key ARN (required when provider=kms)

# -----------------------------------------------------------------------------
# Withdrawal limits
# -----------------------------------------------------------------------------
WITHDRAWAL_DAILY_LIMIT=100.0
WITHDRAWAL_MONTHLY_LIMIT=1000.0
WITHDRAWAL_VERIFICATION_THRESHOLD=50.0
WITHDRAWAL_FEE=0.5
WITHDRAWAL_COOLDOWN_HOURS=24

# -----------------------------------------------------------------------------
# Abuse prevention / reporter safeguards
# -----------------------------------------------------------------------------
MAX_MULTA_PER_USER_PER_MONTH=500.0 # Earnings cap; overflow is truncated + logged
FALSE_REPORT_POINT_PENALTY=10      # Points debited when an authority rejects a report
MAX_REPORTS_PER_HOUR=5
MAX_REPORTS_PER_DAY=20
MAX_REPORTS_PER_PLATE_24H=3        # Anti-harassment: per-plate throttle
PLATE_COOLDOWN_HOURS=24
PLATE_COORDINATED_RADIUS_KM=1.0    # A sighting >=1km away counts as distinct, bypasses the plate cap

# -----------------------------------------------------------------------------
# Federation — self-hosted instances pushing anonymized data to the hub
# Set FEDERATION_ENABLED=true on instances that should sync to multando.com.
# -----------------------------------------------------------------------------
FEDERATION_ENABLED=false
FEDERATION_HUB_URL=https://api.multando.com
FEDERATION_API_KEY=                # Hub-issued API key for this instance
FEDERATION_INSTANCE_ID=            # UUID assigned when registering with the hub
FEDERATION_SYNC_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# Enterprise license (leave empty for community edition)
# Keys use the prefix "mlt_ent_" and must be >= 20 chars.
# ENTERPRISE_FEATURES_ENABLED is derived from the key — do not set it manually.
# -----------------------------------------------------------------------------
ENTERPRISE_LICENSE_KEY=

# White-label (enterprise only)
PLATFORM_NAME=Multando
PLATFORM_LOGO_URL=
PLATFORM_PRIMARY_COLOR=#EF4444
PLATFORM_SUPPORT_EMAIL=support@multando.com
